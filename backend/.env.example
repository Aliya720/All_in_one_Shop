# Used when running the backend directly with `go run ./cmd/api` (not via
# Docker Compose). Copy to backend/.env:
#
#   cp .env.example .env
#
# See ../.env.example for the Docker Compose version of these variables.

APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://ecommerce_user:change_me_to_a_strong_password@localhost:5432/ecommerce?sslmode=disable

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY_HOURS=72

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

ALLOWED_ORIGINS=*

SEED_ON_START=true

# Local dev only: serve the static frontend from the Go server
FRONTEND_DIR=../frontend
