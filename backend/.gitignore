backups/
*.sql.gz
*.dump

# ---------- Go ----------
backend/bin/
*.exe
*.test
*.out
coverage.txt
coverage.html
vendor/

# ---------- Logs ----------
*.log
logs/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Node (only if you add frontend tooling later) ----------
node_modules/

# ---------- Editors & IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db

