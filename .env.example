# =============================================================================
# Copy this file to .env and fill in real values before running
# docker-compose or the backend directly.
#
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# =============================================================================

# --- Application ---
APP_ENV=production
# Set to "development" locally to enable auto-seeding of sample data.

# --- Database (used by the "db" container AND by the backend's
# DATABASE_URL, which docker-compose assembles from these) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change_me_to_a_strong_password

# If running the backend OUTSIDE Docker (e.g. `go run`), set this
# directly instead of relying on the POSTGRES_* vars above:
DATABASE_URL=postgres://ecommerce_user:change_me_to_a_strong_password@localhost:5432/ecommerce?sslmode=disable

# --- Auth ---
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY_HOURS=72

# Default admin account auto-created on first boot if it doesn't exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- CORS ---
# "*" is fine for local development. For production, set this to your
# real frontend origin, e.g. https://shop.example.com
ALLOWED_ORIGINS=*

# --- Seeding ---
# Set to "true" to (re)apply seed/seed.sql even when APP_ENV=production.
# Seeding is idempotent (ON CONFLICT DO NOTHING), so it's safe to leave
# this on, but it's off by default in production to avoid surprises.
SEED_ON_START=false

# --- Docker Compose port binding (Oracle Cloud / shared-server setups) ---
# The Nginx container's port is published on the HOST at this address:port.
# Keep APP_BIND_ADDRESS=127.0.0.1 in production so the app is reachable
# ONLY through the host's own Nginx reverse proxy, never directly from
# the internet. Change APP_PORT if 8081 is already in use on your VM --
# see the "Oracle Cloud Deployment" section of README.md for how to check.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
