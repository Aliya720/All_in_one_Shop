# =============================================================================
# Optional systemd unit for the e-commerce Docker Compose stack.
#
# The docker-compose.yml already sets `restart: unless-stopped` on every
# container, which makes Docker itself restart them automatically after a
# crash or VM reboot (as long as the Docker daemon's own systemd service,
# `docker.service`, is enabled -- it is by default). This unit is OPTIONAL
# and only useful if you prefer to manage the whole stack as a single named
# systemd service (e.g. `systemctl status ecommerce`, `systemctl restart
# ecommerce`) rather than using `docker compose` commands directly.
#
# Install:
#   sudo cp scripts/ecommerce.service.example /etc/systemd/system/ecommerce.service
#   sudo sed -i "s#/opt/ecommerce-shop#$(pwd)#" /etc/systemd/system/ecommerce.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ecommerce.service
#
# This unit does not conflict with, disable, or restart any other systemd
# service already running on the host.
# =============================================================================

[Unit]
Description=E-commerce application (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ecommerce-shop
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
